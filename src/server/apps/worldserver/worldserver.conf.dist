#                    73824 - 10% buff Alliance
#                    73825 - 15% buff Alliance
#                    73826 - 20% buff Alliance
#                    73827 - 25% buff Alliance
#                    73828 - 30% buff Alliance

ICC.Buff.Horde    = 73822
