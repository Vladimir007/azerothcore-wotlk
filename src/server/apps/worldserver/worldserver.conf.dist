Quests.EnableQuestTracker = 0

#
#   QuestPOI.Enabled
#        Description: Show points of interest on the map
#        Default:     1 - Enabled
#                     0 - Disabled

QuestPOI.Enabled = 1

#
#    Quests.LowLevelHideDiff
#        Description: Level difference between player and quest level at which quests are
